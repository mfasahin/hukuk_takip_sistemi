<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form id="createForm">
                <div class="modal-header text-white" style="background-color: #01538b;">
                    <h5 class="modal-title">Müşteri Bilgileri</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="container-fluid">
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label for="MustNo" class="form-label fw-bold">Müşteri Numarası</label>
                                <input type="text" id="MustNo" name="MustNo" class="form-control bg-light" readonly style="cursor: not-allowed;" />
                            </div>
                            <div class="col-md-4">
                                <label for="MustAd" class="form-label fw-bold">Müşteri Adı / Unvan <span class="text-danger">*</span></label>
                                <input type="text" id="MustAd" name="MustAd" class="form-control only-text" maxlength="50" placeholder="Örn: Ahmet" required />
                            </div>
                            <div class="col-md-4">
                                <label for="MustSoyad" class="form-label fw-bold">Müşteri Soyadı</label>
                                <input type="text" id="MustSoyad" name="MustSoyad" class="form-control only-text" maxlength="50" placeholder="Örn: Yılmaz" />
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label for="MustKimlikNo" class="form-label fw-bold">TC Kimlik No</label>
                                <input type="text" id="MustKimlikNo" name="MustKimlikNo" class="form-control only-number" maxlength="11" placeholder="11 Haneli TC" />
                            </div>
                            <div class="col-md-4">
                                <label for="MustVknNo" class="form-label fw-bold">Vergi Kimlik No</label>
                                <input type="text" id="MustVknNo" name="MustVknNo" class="form-control only-number" maxlength="10" placeholder="10 Haneli VKN" />
                            </div>
                            <div class="col-md-4">
                                <label for="MustEposta" class="form-label fw-bold">E-posta <span class="text-danger">*</span></label>
                                <input type="email" id="MustEposta" name="MustEposta" class="form-control" maxlength="100" placeholder="ornek@domain.com" required />
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label for="MustTelNo" class="form-label fw-bold">Telefon No <span class="text-danger">*</span></label>
                                <input type="text" id="MustTelNo" name="MustTelNo" class="form-control" maxlength="13" placeholder="5XX XXX XX XX" required />
                            </div>
                        </div>

                        <!-- Genel Form Hata Mesajının Alt Tarafta Görüneceği Alan -->
                        <div id="formGeneralError" class="row d-none">
                            <div class="col-12">
                                <div class="alert alert-danger mb-0 text-center py-2 error-message-container"></div>
                            </div>
                        </div>

                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="button" id="createSaveBtn" class="btn btn-success px-4">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

