﻿@model IEnumerable<Presentation.Models.MusteriModel>
@{
    ViewBag.Title = "Müsteri Listesi";
}

<h2>Müşteriler</h2>

<tr>
    <td colspan="6">
        <div style="display:flex; justify-content:flex-end; gap:10px; margin-bottom:10px;">
            <button type="button" class="btn btn-danger" id="deleteSelectedBtn">
                Seçilenleri Sil
            </button>
            <button type="button" class="btn btn-success"
                    data-bs-toggle="modal"
                    data-bs-target="#createModal">
                Müşteri Ekle
            </button>
        </div>

        @*<div style="display:flex; justify-content:flex-end;">
            <button type="button" class="btn btn-success"
                    data-bs-toggle="modal"
                    data-bs-target="#createModal">
                Müşteri Ekle
            </button>
        </div>*@
    </td>
</tr>

<table class="table">
    <thead>
        <tr>
            <th>

                <input type="checkbox" id="selectAll" />
            </th>
            <th>Müşteri Numarası</th>
            <th>Müşteri Adı</th>
            <th>Müşteri Soyadı</th>
            <th>TC Kimlik Numarası</th>
            <th>Vergi Kimlik Numarası</th>
            <th>Müşteri E-Posta</th>
            <th>Müşteri Telefon Numarası</th>
            <th>İşlem</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var musteri in Model)
        {
            <tr>
                <td>
                    <input type="checkbox" class="rowCheckbox" value="@musteri.MusteriId" />
                </td>
                <td>@musteri.MustNo</td>
                <td>@musteri.MustAd</td>
                <td>@musteri.MustSoyad</td>
                <td>@musteri.MustKimlikNo</td>
                <td>@musteri.MustVknNo</td>
                <td>@musteri.MustEposta</td>
                <td>@musteri.MustTelNo</td>
                <td>
                    <div class="dropdown">
                        <button class="btn btn-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item text-danger updateBtn" data-id="@musteri.MusteriId">Güncelle</a>
                            </li>
                            <li>
                                <a class="dropdown-item text-danger deleteBtn" data-id="@musteri.MusteriId">Sil</a>
                            </li>
                        </ul>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@Html.Partial("_MusteriModals")

@section Scripts {
    <script src="~/Scripts/crud.js"></script>
    <script>
        initCrud("Musteri", ["MusteriId", "MustNo", "MustAd", "MustSoyad", "MustKimlikNo", "MustVknNo", "MustEposta", "MustTelNo"]);

        // Tümünü seç/deselect
        $("#selectAll").on("change", function () {
            $(".rowCheckbox").prop("checked", $(this).prop("checked"));
        });

        // Seçilenleri Sil butonu
        $("#deleteSelectedBtn").on("click", function () {
            var selectedIds = $(".rowCheckbox:checked").map(function () {
                return $(this).val();
            }).get();

            if (selectedIds.length === 0) {
                alert("Lütfen silmek için en az bir müşteri seçin.");
                return;
            }

            if (!confirm(selectedIds.length + " kaydı silmek istediğinize emin misiniz?")) {
                return;
            }

            // AJAX ile backend'e gönder
            $.ajax({
                url: "/Musteri/DeleteSelected",
                type: "POST",
                traditional: true, // array gönderimi için
                data: {
                    ids: selectedIds,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (result) {
                    if (result.success) {
                        alert("Seçilen kayıtlar silindi.");
                        location.reload();
                    } else {
                        alert("Silme işlemi başarısız.");
                    }
                }
            });
        });

    </script>
}