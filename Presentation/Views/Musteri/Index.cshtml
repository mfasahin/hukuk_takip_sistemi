﻿@model IEnumerable<Presentation.Models.MusteriModel>
@{
    ViewBag.Title = "Müsteri Listesi";
}

<h2>Müşteriler</h2>

<div style="display:flex; justify-content:flex-end; gap:10px; margin-bottom:10px;">
    <button type="button" class="btn btn-danger" id="deleteSelectedBtn">
        Seçilenleri Sil
    </button>
    <button type="button" class="btn btn-success"
            data-bs-toggle="modal"
            data-bs-target="#createModal">
        Müşteri Ekle
    </button>
</div>

<table class="table">
    <thead>
        <tr>
            <th>

                <input type="checkbox" id="selectAll" />
            </th>
            <th>Müşteri Numarası</th>
            <th>Müşteri Adı</th>
            <th>Müşteri Soyadı</th>
            <th>TC Kimlik Numarası</th>
            <th>Vergi Kimlik Numarası</th>
            <th>Müşteri E-Posta</th>
            <th>Müşteri Telefon Numarası</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var musteri in Model)
        {
            <tr>
                <td>
                    <input type="checkbox" class="rowCheckbox" value="@musteri.MusteriId" />
                </td>
                <td>@musteri.MustNo</td>
                <td>@musteri.MustAd</td>
                <td>@musteri.MustSoyad</td>
                <td>@musteri.MustKimlikNo</td>
                <td>@musteri.MustVknNo</td>
                <td>@musteri.MustEposta</td>
                <td>@musteri.MustTelNo</td>
                <td>
                    <div class="dropdown">
                        <button class="btn btn-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item text-danger updateBtn" data-id="@musteri.MusteriId">Güncelle</a>
                            </li>
                            <li>
                                <a class="dropdown-item text-danger deleteBtn" data-id="@musteri.MusteriId">Sil</a>
                            </li>
                        </ul>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@Html.Partial("_MusteriModals", new Presentation.Models.MusteriModel())

@section Scripts {
    <script src="~/Scripts/crud.js"></script>
    <script>
        initCrud("Musteri", ["MusteriId", "MustNo", "MustAd", "MustSoyad", "MustKimlikNo", "MustVknNo", "MustEposta", "MustTelNo"], {
            validationRules: {
                "MustNo": function (value) {
                    if (!/^[0-9]+$/.test(value)) return "Müşteri numarası sadece rakamlardan oluşmalıdır.";
                    if (parseInt(value) <= 0) return "Müşteri numarası 0'dan büyük olmalıdır.";
                    return null;
                },
                "MustAd": function (value) {
                    if (!/^[a-zA-ZğüşöçıİĞÜŞÖÇ]+$/.test(value)) return "Müşteri Adı sadece harflerden oluşmalıdır.";
                    return null;
                },
                "MustSoyad": function (value, allValues) {
                    if (value && !/^[a-zA-ZğüşöçıİĞÜŞÖÇ]+$/.test(value)) {
                        return "Müşteri Soyadı sadece harflerden oluşmalıdır.";
                    }
                    // Soyad doluysa TC Kimlik zorunlu
                    if (value && (!allValues.MustKimlikNo || allValues.MustKimlikNo.trim() === "")) {
                        return "Soyad dolu olduğunda TC Kimlik No zorunludur.";
                    }
                    // Soyad boşsa VKN zorunlu
                    if (!value && (!allValues.MustVknNo || allValues.MustVknNo.trim() === "")) {
                        return "Soyad boş olduğunda VKN No zorunludur.";
                    }
                    return null;
                },
                "MustKimlikNo": function (value, allValues) {
                    // Soyad doluysa TC Kimlik zorunlu
                    if (allValues.MustSoyad && (!value || value.trim() === "")) {
                        return "TC Kimlik Numarası zorunludur.";
                    }
                    return null;
                },
                "MustVknNo": function (value, allValues) {
                    // Soyad boşsa VKN zorunlu
                    if (!allValues.MustSoyad && (!value || value.trim() === "")) {
                        return "Soyad boş olduğunda VKN No zorunludur.";
                    }
                    // Soyad ve TC dolu ise VKN opsiyonel → hata dönme
                    return null;
                }
            }
        });



