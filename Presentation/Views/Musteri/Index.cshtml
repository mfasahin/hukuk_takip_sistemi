@model IEnumerable<Presentation.Models.MusteriModel>
@{
    ViewBag.Title = "Müsteri Listesi";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Müşteriler</h2>
    <button type="button" class="btn btn-success"
            data-bs-toggle="modal"
            data-bs-target="#createModal">
        Müşteri Ekle
    </button>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle" id="musteriTable">
        <thead>
            <!-- 1. Satır: Kolon Başlıkları (Sadece Tıklayınca Arama Açılır) -->
            <tr>
                <th style="cursor:pointer;">Müşteri Numarası</th>
                <th style="cursor:pointer;">Müşteri Adı</th>
                <th style="cursor:pointer;">Müşteri Soyadı</th>
                <th style="cursor:pointer;">TC Kimlik Numarası</th>
                <th style="cursor:pointer;">Vergi Kimlik Numarası</th>
                <th style="cursor:pointer;">Müşteri E-Posta</th>
                <th style="cursor:pointer;">Müşteri Telefon Numarası</th>
            </tr>
            <!-- 2. Satır: Gizli Arama Kutuları -->
            <tr class="bg-light search-row" style="display: none;">
                <td><input type="text" class="form-control form-control-sm column-search" placeholder="Ara..." data-col="0"></td>
                <td><input type="text" class="form-control form-control-sm column-search" placeholder="Ara..." data-col="1"></td>
                <td><input type="text" class="form-control form-control-sm column-search" placeholder="Ara..." data-col="2"></td>
                <td><input type="text" class="form-control form-control-sm column-search" placeholder="Ara..." data-col="3"></td>
                <td><input type="text" class="form-control form-control-sm column-search" placeholder="Ara..." data-col="4"></td>
                <td><input type="text" class="form-control form-control-sm column-search" placeholder="Ara..." data-col="5"></td>
                <td><input type="text" class="form-control form-control-sm column-search" placeholder="Ara..." data-col="6"></td>
                <td></td>
            </tr>
        </thead>
        <tbody>
            @foreach (var musteri in Model)
            {
                <tr>
                    <td>@musteri.MustNo</td>
                    <td>@musteri.MustAd</td>
                    <td>@musteri.MustSoyad</td>
                    <td>@musteri.MustKimlikNo</td>
                    <td>@musteri.MustVknNo</td>
                    <td>@musteri.MustEposta</td>
                    <td>@musteri.MustTelNo</td>
                    <td>
                        <div class="dropdown">
                            <button class="btn btn-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            </button>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item text-danger updateBtn" data-id="@musteri.MusteriId">Güncelle</a>
                                </li>
                                <li>
                                    <a class="dropdown-item text-danger deleteBtn" data-id="@musteri.MusteriId">Sil</a>
                                </li>
                            </ul>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Tablo Altındaki Kayıt Gösterim ve Sayfalama Kartı -->
<div class="card p-3 my-3 border-0 shadow-sm bg-light">
    <div class="row align-items-center g-3">
        <div class="col-md-4 d-flex align-items-center gap-2">
            <label for="pageSizeSelect" class="form-label mb-0 fw-medium">Sayfada</label>
            <select id="pageSizeSelect" class="form-select form-select-sm" style="width: auto;">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="25">25</option>
                <option value="50">50</option>
            </select>
            <span class="fw-medium">kayıt göster</span>
        </div>

        <div class="col-md-4 text-center text-muted small">
            <span id="tableInfo"></span>
        </div>

        <div class="col-md-4 d-flex justify-content-end align-items-center gap-3">
            <div class="text-muted small">
                Toplam: <strong id="totalRecordCount">@Model.Count()</strong> |
                Sayfa: <strong id="currentPageNum">1</strong> / <strong id="totalPagesNum">1</strong>
            </div>
            <nav>
                <ul class="pagination pagination-sm mb-0" id="paginationNav"></ul>
            </nav>
        </div>
    </div>
</div>

@Html.Partial("_MusteriModals", new Presentation.Models.MusteriModel())

@section Scripts {
    <!-- 1. Önce validation options ve kurallar yüklenmeli -->
    <script src="~/Scripts/Musteri/musteriValidation.js?v=2.0"></script>

    <!-- 2. Sonra genel CRUD kütüphanesi yüklenmeli -->
    <script src="~/Scripts/crud.js?v=1.2"></script>

    <!-- 3. Sayfalama -->
    <script src="~/Scripts/Musteri/tablePagination.js"></script>

    <script>
        $(document).ready(function () {
            initTablePagination("musteriTable", "pageSizeSelect", "paginationNav", "tableInfo");

            // musteriOptions nesnesinin 3. parametre olarak iletildiğinden emin ol!
            initCrud("Musteri",
                ["MusteriId", "MustNo", "MustAd", "MustSoyad", "MustKimlikNo", "MustVknNo", "MustEposta", "MustTelNo"],
                musteriOptions
            );
        });
    </script>
}