@model IEnumerable<Presentation.Models.UrunModel>
@{
    ViewBag.Title = "Ürün Listesi";
}

<!-- Halkbank Mavisi Çerçeveli Kart Yapısı -->
<div class="card outlined-card my-4">
    <!-- Çizginin üstünde duran başlık -->
    <span class="outlined-card-title">Ürünler</span>

    <!-- Kart Üst Barı: Sol Tarafa Dışa Aktar Butonları, Sağ Tarafa Arama & Ekleme -->
    <div class="card-header bg-transparent border-0 pt-4 pb-2 px-4 d-flex justify-content-between align-items-center">

        <!-- Sol Taraf: Excel, PDF ve Yazdır Buton Grubu -->
        <div class="d-flex align-items-center gap-2">
            <span class="text-muted small fw-medium me-1">Dışa Aktar:</span>
            <div class="btn-group btn-group-sm shadow-sm" role="group" aria-label="Dışa Aktar">
                <button type="button" class="btn btn-outline-light text-dark border border-light-subtle bg-white hover-elevate" id="btnExportExcel" title="Excel'e Aktar">
                    <i class="bi bi-file-earmark-excel text-success me-1"></i> Excel
                </button>
                <button type="button" class="btn btn-outline-light text-dark border border-light-subtle bg-white hover-elevate" id="btnExportPdf" title="PDF İndir">
                    <i class="bi bi-file-earmark-pdf text-danger me-1"></i> PDF
                </button>
                <button type="button" class="btn btn-outline-light text-dark border border-light-subtle bg-white hover-elevate" id="btnPrint" title="Yazdır">
                    <i class="bi bi-printer text-primary me-1"></i> Yazdır
                </button>
            </div>
        </div>

        <!-- Sağ Taraf: Animasyonlu Ekleme ve Arama Butonları -->
        <div class="d-flex align-items-center gap-2">
            <!-- 1. Animasyonlu Expandable Arama Çubuğu -->
            <div class="expandable-search" id="searchWrapper">
                <button type="button" class="search-btn" id="searchTriggerBtn">
                    <i class="bi bi-search"></i>
                </button>
                <input type="text" id="globalSearchInput" class="search-input" placeholder="Ürün ara..." autocomplete="off" />
            </div>

            <!-- 2. Animasyonlu Expandable Ürün Ekle Butonu -->
            <button type="button" class="btn btn-success expandable-btn d-flex align-items-center" data-bs-toggle="modal" data-bs-target="#createModal">
                <i class="bi bi-plus-lg fs-5"></i>
                <span class="btn-text">Yeni Ürün Ekle</span>
            </button>
        </div>

    </div>

    <!-- Tablo Alanı -->
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0" id="urunTable">
            <thead class="table-light text-secondary small text-uppercase">
                <tr>
                    <th class="ps-4">Ürün Adı</th>
                    <th>Ürün Kodu</th>
                    <th>Son Geçerlilik Tarihi</th>
                    <th class="text-end pe-4 no-print">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var urun in Model)
                {
                    <tr>
                        <td class="ps-4">@urun.UrunAd</td>
                        <td>@urun.UrunKod</td>
                        <td>@(urun.SonGecerlilikTar.HasValue ? urun.SonGecerlilikTar.Value.ToString("dd.MM.yyyy") : "-")</td>
                        <td class="text-end pe-4 no-print">
                            <div class="dropdown">
                                <button class="btn btn-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"></button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                    <li>
                                        <a class="dropdown-item updateBtn py-2" href="javascript:void(0);" data-id="@urun.UrunId">
                                            <i class="bi bi-pencil me-2 text-primary"></i>Güncelle
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li>
                                        <a class="dropdown-item text-danger deleteBtn py-2" href="javascript:void(0);" data-id="@urun.UrunId">
                                            <i class="bi bi-trash me-2"></i>Sil
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Kart Altı: Sayfalama ve Alt Bilgiler -->
    <div class="card-footer bg-transparent border-top py-3 px-4">
        <div class="row align-items-center g-3">
            <div class="col-md-4 d-flex align-items-center gap-2">
                <label for="urunPageSize" class="form-label mb-0 small text-muted">Sayfada</label>
                <select id="urunPageSize" class="form-select form-select-sm border-light bg-light" style="width: auto;">
                    <option value="5">5</option>
                    <option value="10" selected>10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
                <span class="small text-muted">kayıt göster</span>
            </div>

            <div class="col-md-4 text-center text-muted small">
                <span id="urunTableInfo"></span>
            </div>

            <div class="col-md-4 d-flex justify-content-end align-items-center gap-3">
                <div class="text-muted small">
                    Toplam: <strong id="urunTotalRecordCount">@Model.Count()</strong> |
                    Sayfa: <strong id="urunCurrentPageNum">1</strong> / <strong id="urunTotalPagesNum">1</strong>
                </div>
                <nav>
                    <ul class="pagination pagination-sm mb-0" id="urunPaginationNav"></ul>
                </nav>
            </div>
        </div>
    </div>
</div>

@Html.Partial("_UrunModals", new Presentation.Models.UrunModel())

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Excel ve PDF Dışa Aktarım CDN Kütüphaneleri -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>

    <script src="~/Scripts/common.js"></script>
    <script src="~/Scripts/crud.js?v=2.0"></script>
    <script src="~/Scripts/Urun/urunValidation.js"></script>
    <script src="~/Scripts/Urun/tablePagination.js"></script>

    <script>
        $(document).ready(function () {
            // Tarih alanlarında varsayılan placeholder
            $(document).on("focus", 'input[type="date"]', function () {
                $(this).attr("placeholder", "gg.aa.yyyy");
            });

            // Ürünler tablosu için özelleştirilmiş sayfalama ve arama fonksiyonu
            initTablePagination("urunTable", "urunPageSize", "urunPaginationNav", "urunTableInfo", "globalSearchInput");

            // Genel CRUD motoru başlatma
            initCrud("Urun", ["UrunId", "UrunAd", "UrunKod", "SonGecerlilikTar"], urunOptions);

            // Arama İkonu Tıklama Mantığı
            $("#searchTriggerBtn").on("click", function (e) {
                e.stopPropagation();
                $("#searchWrapper").toggleClass("expanded");
                if ($("#searchWrapper").hasClass("expanded")) {
                    $("#globalSearchInput").focus();
                }
            });

            $("#globalSearchInput").on("click", function (e) {
                e.stopPropagation();
            });

            $(document).on("click", function () {
                if ($("#globalSearchInput").val().trim() === "") {
                    $("#searchWrapper").removeClass("expanded");
                }
            });

            // --------------------------------------------------------------------------
            // DIŞA AKTAR BUTONLARI (EXCEL, PDF, YAZDIR)
            // --------------------------------------------------------------------------

            // 1. EXCEL
            $("#btnExportExcel").on("click", function () {
                var data = [];
                var headers = ["Urun Adi", "Urun Kodu", "Son Gecerlilik Tarihi"];
                data.push(headers);

                $("#urunTable tbody tr:visible").each(function () {
                    var $tds = $(this).find("td");
                    if ($tds.length > 1) {
                        data.push([
                            $tds.eq(0).text().trim(),
                            $tds.eq(1).text().trim(),
                            $tds.eq(2).text().trim()
                        ]);
                    }
                });

                var wb = XLSX.utils.book_new();
                var ws = XLSX.utils.aoa_to_sheet(data);
                XLSX.utils.book_append_sheet(wb, ws, "Urunler");
                XLSX.writeFile(wb, "Urun_Listesi.xlsx");
            });

            // 2. YAZDIR
            $("#btnPrint").on("click", function () {
                window.print();
            });

            // 3. PDF (AutoTable Mantığı)
            $("#btnExportPdf").on("click", function () {
                try {
                    var { jsPDF } = window.jspdf;
                    var doc = new jsPDF('p', 'mm', 'a4');

                    var headers = [["Urun Adi", "Urun Kodu", "Son Gecerlilik Tarihi"]];
                    var body = [];

                    $("#urunTable tbody tr:visible").each(function () {
                        var $tds = $(this).find("td");
                        if ($tds.length > 1) {
                            body.push([
                                $tds.eq(0).text().trim(),
                                $tds.eq(1).text().trim(),
                                $tds.eq(2).text().trim()
                            ]);
                        }
                    });

                    doc.autoTable({
                        head: headers,
                        body: body,
                        startY: 15,
                        theme: 'grid',
                        headStyles: { fillColor: [1, 83, 139] },
                        styles: { fontSize: 10, cellPadding: 4 }
                    });

                    doc.save("Urun_Listesi.pdf");
                } catch (err) {
                    console.error("PDF Oluşturma Hatası:", err);
                    showErrorModal("PDF dosyası indirilirken bir sorun oluştu.");
                }
            });
        });
    </script>
}