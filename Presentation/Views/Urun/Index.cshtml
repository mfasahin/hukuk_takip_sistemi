@model IEnumerable<Presentation.Models.UrunModel>
@{
    ViewBag.Title = "Ürün Listesi";
}

<h2>Ürünler</h2>

<!-- Ürün Ekle Butonu -->
<div style="display:flex; justify-content:flex-end; gap:10px; margin-bottom:10px;">
    <button type="button" class="btn btn-danger" id="deleteSelectedBtn">
        Seçilenleri Sil
    </button>
    <button type="button" class="btn btn-success"
            data-bs-toggle="modal"
            data-bs-target="#createModal">
        Ürün Ekle
    </button>
</div>

<table class="table">
    <thead>
        <tr>
            <th>
                <!-- Tümünü seç/deselect için -->
                <input type="checkbox" id="selectAll" />
            </th>
            <th>Ürün Adı</th>
            <th>Ürün Kodu</th>
            <th>Ürün Son Geçerlilik Tarihi</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var urun in Model)
        {
            <tr>
                <td>
                    <input type="checkbox" class="rowCheckbox" value="@urun.UrunId" />
                </td>
                <td>@urun.UrunAd</td>
                <td>@urun.UrunKod</td>
                <td>
                    @(urun.SonGecerlilikTar.HasValue
                    ? urun.SonGecerlilikTar.Value.ToString("dd.MM.yyyy")
                    : "")
                </td>
                <td>
                    <div class="dropdown">
                        <button class="btn btn-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item text-danger updateBtn" data-id="@urun.UrunId">Güncelle</a>
                            </li>
                            <li>
                                <a class="dropdown-item text-danger deleteBtn" data-id="@urun.UrunId">Sil</a>
                            </li>
                        </ul>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@Html.Partial("_UrunModals", new Presentation.Models.UrunModel())

@section Scripts {
    <script src="~/Scripts/crud.js"></script>
    <script>
        initCrud("Urun", ["UrunId", "UrunAd", "UrunKod", "SonGecerlilikTar"], {
            validationRules: {
                "UrunAd": function (value) {
                    if (!/^[a-zA-ZğüşöçıİĞÜŞÖÇ]+$/.test(value)) return "Ürün Adı sadece harflerden oluşmalıdır.";
                    return null;
                },
                "UrunKod": function (value) {
                    if (!/^[a-zA-ZğüşöçıİĞÜŞÖÇ]+$/.test(value)) return "Ürün Kodu sadece harflerden oluşmalıdır.";
                    return null;
                },
                "SonGecerlilikTar": function (value, allValues) {
                    if (!value || value.trim() === "") {
                        return "Son geçerlilik tarihi zorunludur.";
                    }

                    // Geçerli tarih formatı mu?
                    var date = new Date(value);
                    if (isNaN(date.getTime())) {
                        return "Geçerli bir tarih giriniz.";
                    }

                    // Geçerlilik tarihi geçmiş olamaz (bugünden küçükse hata)
                    var today = new Date();
                    today.setHours(0, 0, 0, 0); // sadece gün karşılaştırması için
                    if (date < today) {
                        return "Son geçerlilik tarihi geçmiş olamaz.";
                    }

                    return null;
                }
            }
        });
    </script>
}