@model IEnumerable<Presentation.Models.AvukatModel>
@{
    ViewBag.Title = "Avukat Listesi";
}

<h2>Avukatlar</h2>

<!-- Avukat Ekle Butonu -->
<div style="display:flex; justify-content:flex-end; gap:10px; margin-bottom:10px;">
    <button type="button" class="btn btn-danger" id="deleteSelectedBtn">
        Seçilenleri Sil
    </button>
    <button type="button" class="btn btn-success"
            data-bs-toggle="modal"
            data-bs-target="#createModal">
        Avukat Ekle
    </button>
</div>

<!-- Avukat Listesi -->
<table class="table">
    <thead>
        <tr>
            <th>
                <!-- Tümünü seç/deselect için -->
                <input type="checkbox" id="selectAll" />
            </th>
            <th>Avukat Adı</th>
            <th>Avukat Soyadı</th>
            <th>TBB Sicil Numarası</th>
            <th>Avukat Telefon Numarası</th>
            <th>Avukat E-Posta</th>
            <th>Hukuk Büro Adı</th>
            <th>Hukuk Büro Adresi</th>
            <th>Ofis Telefon Numarası
            <th>
        </tr>
    </thead>
    <tbody>
        @foreach (var avukat in Model)
        {
            <tr>
                <td>
                    <input type="checkbox" class="rowCheckbox" value="@avukat.AvukatId" />
                </td>
                <td>@avukat.AvktAd</td>
                <td>@avukat.AvktSoyad</td>
                <td>@avukat.TbbSicilNo</td>
                <td>@avukat.AvktTelNo</td>
                <td>@avukat.AvktEposta</td>
                <td>@avukat.HkkBuroAd</td>
                <td>@avukat.HkkBuroAdres</td>
                <td>@avukat.OfisTelNo</td>
                <td>
                    <div class="dropdown">
                        <button class="btn btn-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item text-danger updateBtn" data-id="@avukat.AvukatId">Güncelle</a>
                            </li>
                            <li>
                                <a class="dropdown-item text-danger deleteBtn" data-id="@avukat.AvukatId">Sil</a>
                            </li>
                        </ul>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@Html.Partial("_AvukatModals", new Presentation.Models.AvukatModel())

@section Scripts {
    <script src="~/Scripts/crud.js"></script>
    <script>
        initCrud("Avukat", ["AvukatId", "AvktAd", "AvktSoyad", "TbbSicilNo", "AvktEposta", "AvktTelNo", "HkkBuroAd", "HkkBuroAdres", "OfisTelNo"], {
            validationRules: {
                "AvktAd": function (value) {
                    if (!/^[a-zA-ZğüşöçıİĞÜŞÖÇ]+$/.test(value)) return "Avukat Adı sadece harflerden oluşmalıdır.";
                    return null;
                },
                "AvktSoyad": function (value) {
                    if (!/^[a-zA-ZğüşöçıİĞÜŞÖÇ]+$/.test(value)) return "Avukat Soyadı sadece harflerden oluşmalıdır.";
                    return null;
                },
                "TbbSicilNo": function (value, allValues) {
                    if (!/^[0-9]+$/.test(value)) return "TBB sicil numarası sadece rakamlardan oluşmalıdır.";
                    if (parseInt(value) <= 0) return "TBB sicil numarası 0'dan büyük olmalıdır.";
                    return null;
                },
                "AvktTelNo": function (value, allValues) {
                    if (!/^[0-9]+$/.test(value)) return "Avukat telefon numarası sadece rakamlardan oluşmalıdır.";
                    if (parseInt(value) <= 0) return "Avukat telefon numarası 0'dan büyük olmalıdır.";
                    return null;
                },
                "OfisTelNo": function (value, allValues) {
                    if (!/^[0-9]+$/.test(value)) return "Ofis telefon numarası sadece rakamlardan oluşmalıdır.";
                    if (parseInt(value) <= 0) return "Ofis telefon numarası 0'dan büyük olmalıdır.";
                    return null;
                }
            }
        });
            
    </script>
}