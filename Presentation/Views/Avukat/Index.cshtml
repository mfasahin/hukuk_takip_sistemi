@model IEnumerable<Presentation.Models.AvukatModel>
@{
    ViewBag.Title = "Avukat Listesi";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Avukatlar</h2>
    <button type="button" class="btn btn-success"
            data-bs-toggle="modal"
            data-bs-target="#createModal">
        Avukat Ekle
    </button>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle" id="avukatTable">
        <thead>
            <!-- 1. Satır: Kolon Başlıkları (Sadece Tıklayınca Arama Açılır) -->
            <tr>
                <th style="cursor:pointer;">Adı</th>
                <th style="cursor:pointer;">Soyadı</th>
                <th style="cursor:pointer;">TBB Sicil No</th>
                <th style="cursor:pointer;">E-Posta</th>
                <th style="cursor:pointer;">Telefon No</th>
                <th style="cursor:pointer;">Büro Adı</th>
                <th style="cursor:pointer;">Büro Adresi</th>
                <th style="cursor:pointer;">Ofis Tel No</th>
                <th></th> <!-- İşlemler Kolonu -->
            </tr>
            <!-- 2. Satır: Gizli Arama Kutuları -->
            <tr class="bg-light search-row" style="display: none;">
                <td><input type="text" class="form-control form-control-sm avukat-column-search" placeholder="Ara..." data-col="0"></td>
                <td><input type="text" class="form-control form-control-sm avukat-column-search" placeholder="Ara..." data-col="1"></td>
                <td><input type="text" class="form-control form-control-sm avukat-column-search" placeholder="Ara..." data-col="2"></td>
                <td><input type="text" class="form-control form-control-sm avukat-column-search" placeholder="Ara..." data-col="3"></td>
                <td><input type="text" class="form-control form-control-sm avukat-column-search" placeholder="Ara..." data-col="4"></td>
                <td><input type="text" class="form-control form-control-sm avukat-column-search" placeholder="Ara..." data-col="5"></td>
                <td><input type="text" class="form-control form-control-sm avukat-column-search" placeholder="Ara..." data-col="6"></td>
                <td><input type="text" class="form-control form-control-sm avukat-column-search" placeholder="Ara..." data-col="7"></td>
                <td></td>
            </tr>
        </thead>
        <tbody>
            @foreach (var avukat in Model)
            {
                <tr>
                    <td>@avukat.AvktAd</td>
                    <td>@avukat.AvktSoyad</td>
                    <td>@avukat.TbbSicilNo</td>
                    <td>@avukat.AvktEposta</td>
                    <td>@avukat.AvktTelNo</td>
                    <td>@avukat.HkkBuroAd</td>
                    <td>@avukat.HkkBuroAdres</td>
                    <td>@avukat.OfisTelNo</td>
                    <td>
                        <div class="dropdown">
                            <button class="btn btn-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            </button>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item text-danger updateBtn" data-id="@avukat.AvukatId">Güncelle</a>
                                </li>
                                <li>
                                    <a class="dropdown-item text-danger deleteBtn" data-id="@avukat.AvukatId">Sil</a>
                                </li>
                            </ul>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Tablo Altındaki Kayıt Gösterim ve Sayfalama Kartı -->
<div class="card p-3 my-3 border-0 shadow-sm bg-light">
    <div class="row align-items-center g-3">
        <div class="col-md-4 d-flex align-items-center gap-2">
            <label for="avukatPageSize" class="form-label mb-0 fw-medium">Sayfada</label>
            <select id="avukatPageSize" class="form-select form-select-sm" style="width: auto;">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="25">25</option>
                <option value="50">50</option>
            </select>
            <span class="fw-medium">kayıt göster</span>
        </div>

        <div class="col-md-4 text-center text-muted small">
            <span id="avukatTableInfo"></span>
        </div>

        <div class="col-md-4 d-flex justify-content-end align-items-center gap-3">
            <div class="text-muted small">
                Toplam: <strong id="avukatTotalRecordCount">@Model.Count()</strong> |
                Sayfa: <strong id="avukatCurrentPageNum">1</strong> / <strong id="avukatTotalPagesNum">1</strong>
            </div>
            <nav>
                <ul class="pagination pagination-sm mb-0" id="avukatPaginationNav"></ul>
            </nav>
        </div>
    </div>
</div>

@Html.Partial("_AvukatModals", new Presentation.Models.AvukatModel())

@section Scripts {
    <script src="~/Scripts/crud.js?v=1.1"></script>
    <script src="~/Scripts/Avukat/avukatValidation.js"></script>
    <script src="~/Scripts/Avukat/TablePagination.js"></script>

    <script>
        $(document).ready(function () {
            // Avukat tablosu için özelleştirilmiş sayfalama ve filtreleme
            initAvukatTablePagination("avukatTable", "avukatPageSize", "avukatPaginationNav", "avukatTableInfo");

            // Genel CRUD mimarisi ile uyumlu initCrud çağrısı
            initCrud("Avukat", ["AvukatId", "AvktAd", "AvktSoyad", "TbbSicilNo", "AvktEposta", "AvktTelNo", "HkkBuroAd", "HkkBuroAdres", "OfisTelNo"], avukatOptions);
        });
    </script>
}