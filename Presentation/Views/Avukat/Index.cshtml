@model IEnumerable<Presentation.Models.AvukatModel>
@{
    ViewBag.Title = "Avukat Listesi";
}

<!-- Sayfa Üst Başlık Alanı -->
<div class="d-flex justify-content-between align-items-center mb-3" style="max-width: 1250px; margin: 0 auto;">
    <h2 class="fw-bold m-0 text-dark">Avukatlar</h2>
</div>

<!-- Ana Tablo Kartı -->
<div class="card border-0 shadow rounded-3">
    <!-- Kart Üst Barı: Sol Tarafa Dışa Aktar Butonları, Sağ Tarafa Arama & Ekleme -->
    <div class="card-header bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center">

        <!-- Sol Taraf: Excel, PDF ve Yazdır Buton Grubu -->
        <div class="d-flex align-items-center gap-2">
            <span class="text-muted small fw-medium me-1">Dışa Aktar:</span>
            <div class="btn-group btn-group-sm shadow-sm" role="group" aria-label="Dışa Aktar">
                <button type="button" class="btn btn-outline-light text-dark border border-light-subtle bg-white hover-elevate" id="btnExportExcel" title="Excel'e Aktar">
                    <i class="bi bi-file-earmark-excel text-success me-1"></i> Excel
                </button>
                <button type="button" class="btn btn-outline-light text-dark border border-light-subtle bg-white hover-elevate" id="btnExportPdf" title="PDF İndir">
                    <i class="bi bi-file-earmark-pdf text-danger me-1"></i> PDF
                </button>
                <button type="button" class="btn btn-outline-light text-dark border border-light-subtle bg-white hover-elevate" id="btnPrint" title="Yazdır">
                    <i class="bi bi-printer text-primary me-1"></i> Yazdır
                </button>
            </div>
        </div>

        <!-- Sağ Taraf: Animasyonlu Ekleme ve Arama Butonları -->
        <div class="d-flex align-items-center gap-2">
            <!-- 1. Animasyonlu Expandable Arama Çubuğu -->
            <div class="expandable-search" id="searchWrapper">
                <button type="button" class="search-btn" id="searchTriggerBtn">
                    <i class="bi bi-search"></i>
                </button>
                <input type="text" id="globalSearchInput" class="search-input" placeholder="Avukat ara..." autocomplete="off" />
            </div>

            <!-- 2. Animasyonlu Expandable Avukat Ekle Butonu -->
            <button type="button" class="btn btn-success expandable-btn d-flex align-items-center" data-bs-toggle="modal" data-bs-target="#createModal">
                <i class="bi bi-plus-lg fs-5"></i>
                <span class="btn-text">Yeni Avukat Ekle</span>
            </button>
        </div>

    </div>

    <!-- Tablo Alanı -->
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0" id="avukatTable">
            <thead class="table-light text-secondary small text-uppercase">
                <tr>
                    <th class="ps-4">Adı</th>
                    <th>Soyadı</th>
                    <th>TBB Sicil No</th>
                    <th>E-Posta</th>
                    <th>Telefon No</th>
                    <th>Büro Adı</th>
                    <th>Büro Adresi</th>
                    <th>Ofis Tel No</th>
                    <th class="text-end pe-4 no-print">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var avukat in Model)
                {
                    <tr>
                        <td class="ps-4">@avukat.AvktAd</td>
                        <td>@avukat.AvktSoyad</td>
                        <td>@(string.IsNullOrEmpty(avukat.TbbSicilNo) ? "-" : avukat.TbbSicilNo)</td>
                        <td>@(string.IsNullOrEmpty(avukat.AvktEposta) ? "-" : avukat.AvktEposta)</td>
                        <td>@(string.IsNullOrEmpty(avukat.AvktTelNo) ? "-" : avukat.AvktTelNo)</td>
                        <td>@(string.IsNullOrEmpty(avukat.HkkBuroAd) ? "-" : avukat.HkkBuroAd)</td>
                        <td>@(string.IsNullOrEmpty(avukat.HkkBuroAdres) ? "-" : avukat.HkkBuroAdres)</td>
                        <td>@(string.IsNullOrEmpty(avukat.OfisTelNo) ? "-" : avukat.OfisTelNo)</td>
                        <td class="text-end pe-4 no-print">
                            <div class="dropdown">
                                <button class="btn btn-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"></button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                    <li>
                                        <a class="dropdown-item updateBtn py-2" href="javascript:void(0);" data-id="@avukat.AvukatId">
                                            <i class="bi bi-pencil me-2 text-primary"></i>Güncelle
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li>
                                        <a class="dropdown-item text-danger deleteBtn py-2" href="javascript:void(0);" data-id="@avukat.AvukatId">
                                            <i class="bi bi-trash me-2"></i>Sil
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Kart Altı: Sayfalama ve Alt Bilgiler -->
    <div class="card-footer bg-white border-top py-3 px-4">
        <div class="row align-items-center g-3">
            <div class="col-md-4 d-flex align-items-center gap-2">
                <label for="avukatPageSize" class="form-label mb-0 small text-muted">Sayfada</label>
                <select id="avukatPageSize" class="form-select form-select-sm border-light bg-light" style="width: auto;">
                    <option value="5">5</option>
                    <option value="10" selected>10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
                <span class="small text-muted">kayıt göster</span>
            </div>

            <div class="col-md-4 text-center text-muted small">
                <span id="avukatTableInfo"></span>
            </div>

            <div class="col-md-4 d-flex justify-content-end align-items-center gap-3">
                <div class="text-muted small">
                    Toplam: <strong id="avukatTotalRecordCount">@Model.Count()</strong> |
                    Sayfa: <strong id="avukatCurrentPageNum">1</strong> / <strong id="avukatTotalPagesNum">1</strong>
                </div>
                <nav>
                    <ul class="pagination pagination-sm mb-0" id="avukatPaginationNav"></ul>
                </nav>
            </div>
        </div>
    </div>
</div>

@Html.Partial("_AvukatModals", new Presentation.Models.AvukatModel())

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Excel ve PDF Dışa Aktarım CDN Kütüphaneleri -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>

    <script src="~/Scripts/common.js"></script>
    <script src="~/Scripts/crud.js?v=2.0"></script>
    <script src="~/Scripts/Avukat/avukatValidation.js"></script>
    <script src="~/Scripts/Avukat/TablePagination.js"></script>

    <script>
        $(document).ready(function () {
            // Avukat tablosu için sayfalama ve tekli arama başlatma
            initAvukatTablePagination("avukatTable", "avukatPageSize", "avukatPaginationNav", "avukatTableInfo", "globalSearchInput");

            // Genel CRUD motoru
            initCrud("Avukat", ["AvukatId", "AvktAd", "AvktSoyad", "TbbSicilNo", "AvktEposta", "AvktTelNo", "HkkBuroAd", "HkkBuroAdres", "OfisTelNo"], avukatOptions);

            // Arama İkonu Tıklama Mantığı
            $("#searchTriggerBtn").on("click", function (e) {
                e.stopPropagation();
                $("#searchWrapper").toggleClass("expanded");
                if ($("#searchWrapper").hasClass("expanded")) {
                    $("#globalSearchInput").focus();
                }
            });

            $("#globalSearchInput").on("click", function (e) {
                e.stopPropagation();
            });

            $(document).on("click", function () {
                if ($("#globalSearchInput").val().trim() === "") {
                    $("#searchWrapper").removeClass("expanded");
                }
            });

            // --------------------------------------------------------------------------
            // DIŞA AKTAR BUTONLARI (EXCEL, PDF, YAZDIR)
            // --------------------------------------------------------------------------

            // 1. EXCEL
            $("#btnExportExcel").on("click", function () {
                var data = [];
                var headers = ["Ad", "Soyad", "TBB Sicil No", "E-Posta", "Telefon", "Buro Adı", "Buro Adresi", "Ofis Tel"];
                data.push(headers);

                $("#avukatTable tbody tr:visible").each(function () {
                    var $tds = $(this).find("td");
                    if ($tds.length > 1) {
                        data.push([
                            $tds.eq(0).text().trim(),
                            $tds.eq(1).text().trim(),
                            $tds.eq(2).text().trim(),
                            $tds.eq(3).text().trim(),
                            $tds.eq(4).text().trim(),
                            $tds.eq(5).text().trim(),
                            $tds.eq(6).text().trim(),
                            $tds.eq(7).text().trim()
                        ]);
                    }
                });

                var wb = XLSX.utils.book_new();
                var ws = XLSX.utils.aoa_to_sheet(data);
                XLSX.utils.book_append_sheet(wb, ws, "Avukatlar");
                XLSX.writeFile(wb, "Avukat_Listesi.xlsx");
            });

            // 2. YAZDIR
            $("#btnPrint").on("click", function () {
                window.print();
            });

            // 3. PDF (8 Kolon Olduğu İçin Yatay / Landscape A4 Formatta)
            $("#btnExportPdf").on("click", function () {
                try {
                    var { jsPDF } = window.jspdf;
                    var doc = new jsPDF('l', 'mm', 'a4');

                    var headers = [["Ad", "Soyad", "TBB Sicil No", "E-Posta", "Telefon", "Buro Adi", "Buro Adresi", "Ofis Tel"]];
                    var body = [];

                    $("#avukatTable tbody tr:visible").each(function () {
                        var $tds = $(this).find("td");
                        if ($tds.length > 1) {
                            body.push([
                                $tds.eq(0).text().trim(),
                                $tds.eq(1).text().trim(),
                                $tds.eq(2).text().trim(),
                                $tds.eq(3).text().trim(),
                                $tds.eq(4).text().trim(),
                                $tds.eq(5).text().trim(),
                                $tds.eq(6).text().trim(),
                                $tds.eq(7).text().trim()
                            ]);
                        }
                    });

                    doc.autoTable({
                        head: headers,
                        body: body,
                        startY: 15,
                        theme: 'grid',
                        headStyles: { fillColor: [1, 83, 139] },
                        styles: { fontSize: 8, cellPadding: 3 }
                    });

                    doc.save("Avukat_Listesi.pdf");
                } catch (err) {
                    console.error("PDF Oluşturma Hatası:", err);
                    alert("PDF indirilirken bir sorun oluştu.");
                }
            });
        });
    </script>
}