<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form id="createForm">
                <div class="modal-header text-white" style="background-color: #01538b;">
                    <h5 class="modal-title">Avukat Bilgileri</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="container-fluid">
                        <!-- 1. Satır: Ad, Soyad, TBB Sicil No -->
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label for="AvktAd" class="form-label fw-bold">Avukat Adı</label>
                                <input type="text" id="AvktAd" name="AvktAd" class="form-control only-text" maxlength="25" placeholder="Örn: Ahmet" required />
                            </div>
                            <div class="col-md-4">
                                <label for="AvktSoyad" class="form-label fw-bold">Avukat Soyadı</label>
                                <input type="text" id="AvktSoyad" name="AvktSoyad" class="form-control only-text" maxlength="25" placeholder="Örn: Yılmaz" required />
                            </div>
                            <div class="col-md-4">
                                <label for="TbbSicilNo" class="form-label fw-bold">TBB Sicil Numarası</label>
                                <input type="text" id="TbbSicilNo" name="TbbSicilNo" class="form-control only-number" maxlength="10" placeholder="10 Haneli Sicil No" required />
                            </div>
                        </div>

                        <!-- 2. Satır: E-posta, Telefon No, Hukuk Bürosu Adı -->
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label for="AvktEposta" class="form-label fw-bold">Avukat E-posta</label>
                                <input type="email" id="AvktEposta" name="AvktEposta" class="form-control" maxlength="25" placeholder="ornek@domain.com" required />
                            </div>
                            <div class="col-md-4">
                                <label for="AvktTelNo" class="form-label fw-bold">Avukat Telefon Numarası</label>
                                <input type="text" id="AvktTelNo" name="AvktTelNo" class="form-control" maxlength="13" placeholder="5XX XXX XX XX" required />
                            </div>
                            <div class="col-md-4">
                                <label for="HkkBuroAd" class="form-label fw-bold">Hukuk Bürosu Adı</label>
                                <input type="text" id="HkkBuroAd" name="HkkBuroAd" class="form-control" maxlength="50" placeholder="Örn: Yılmaz Hukuk" />
                            </div>
                        </div>

                        <!-- 3. Satır: Hukuk Bürosu Adresi, Ofis Telefon Numarası -->
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label for="HkkBuroAdres" class="form-label fw-bold">Hukuk Bürosu Adresi</label>
                                <input type="text" id="HkkBuroAdres" name="HkkBuroAdres" class="form-control" maxlength="70" placeholder="Büro Adresi" />
                            </div>
                            <div class="col-md-4">
                                <label for="OfisTelNo" class="form-label fw-bold">Ofis Telefon Numarası</label>
                                <input type="text" id="OfisTelNo" name="OfisTelNo" class="form-control" maxlength="13" placeholder="2XX XXX XX XX" />
                            </div>
                        </div>

                        <!-- Genel Form Hata Mesajının Alt Tarafta Görüneceği Alan -->
                        <div id="formGeneralError" class="row d-none">
                            <div class="col-12">
                                <div class="alert alert-danger mb-0 text-center py-2 error-message-container"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="button" id="createSaveBtn" class="btn btn-success px-4">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

