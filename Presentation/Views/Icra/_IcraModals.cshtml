@model Entity.Dto.IcraDto
@using System.Linq

<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1" aria-labelledby="createModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            @using (Html.BeginForm("Create", "Icra", FormMethod.Post, new { id = "createForm" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="createModalLabel">Yeni İcra</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <div class="container-fluid">
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label">Müşteri</label>
                                <select class="form-select" id="createMusteriSelect" name="MusteriId">
                                    <option value="">Seçiniz</option>
                                    @if (ViewBag.MusteriList != null)
                                    {
                                        foreach (var item in (ViewBag.MusteriList as IEnumerable<SelectListItem>))
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Ürün</label>
                                <select class="form-select" id="createUrunSelect" name="UrunId" disabled>
                                    <option value="">Önce müşteri seçiniz</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">İhtar</label>
                                @Html.DropDownListFor(m => m.IhtarUrunId,
                                    Enumerable.Empty<SelectListItem>(),
                                    "Önce ürün seçiniz",
                                    new { @class = "form-select", id = "createIhtarUrunSelect", disabled = "disabled" })
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.MahkemeId, "Mahkeme", new { @class = "form-label" })
                                @Html.DropDownListFor(m => m.MahkemeId,
                                    ViewBag.MahkemeList as IEnumerable<SelectListItem>,
                                    "Seçiniz", new { @class = "form-select", id = "createMahkemeId" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.IcraDosyaNo, "İcra Dosya No", new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.IcraDosyaNo, new { @class = "form-control", id = "createIcraDosyaNo", name = "IcraDosyaNo" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.IcraTakipTar, "İcra Takip Tarihi", new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.IcraTakipTar, new { @class = "form-control", type = "date", id = "createIcraTakipTar" })
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" id="createSaveBtn" class="btn btn-primary">Kaydet</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Update Modal -->
<div class="modal fade" id="updateModal" tabindex="-1" aria-labelledby="updateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            @using (Html.BeginForm("Update", "Icra", FormMethod.Post, new { id = "updateForm" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.IcraId, new { id = "IcraId" })
                @Html.HiddenFor(m => m.IhtarUrunId, new { id = "updateIhtarUrunIdHidden" })

                <div class="modal-header">
                    <h5 class="modal-title" id="updateModalLabel">İcra Güncelle</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <div class="container-fluid">
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label">Müşteri</label>
                                <select class="form-select" id="updateMusteriSelect" disabled>
                                    <option value="">Seçiniz</option>
                                    @if (ViewBag.MusteriList != null)
                                    {
                                        foreach (var item in (ViewBag.MusteriList as IEnumerable<SelectListItem>))
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Ürün</label>
                                <select class="form-select" id="updateUrunSelect" disabled>
                                    <option value="">Seçiniz</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">İhtar</label>
                                <select class="form-select" id="updateIhtarUrunSelect" disabled>
                                    <option value="">Seçiniz</option>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.MahkemeId, "Mahkeme", new { @class = "form-label" })
                                @Html.DropDownListFor(m => m.MahkemeId,
                                    ViewBag.MahkemeList as IEnumerable<SelectListItem>,
                                    "Seçiniz", new { @class = "form-select", id = "MahkemeId" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.IcraDosyaNo, "İcra Dosya No", new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.IcraDosyaNo, new { @class = "form-control", id = "IcraDosyaNo", name = "IcraDosyaNo" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.IcraTakipTar, "İcra Takip Tarihi", new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.IcraTakipTar, new { @class = "form-control", type = "date", id = "IcraTakipTar" })
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" id="updateSaveBtn" class="btn btn-primary">Güncelle</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                </div>
            }
        </div>
    </div>
</div>