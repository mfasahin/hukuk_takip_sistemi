@model IEnumerable<Entity.Dto.IcraDto>
@{
    ViewBag.Title = "İcra Takip";
}

<!-- Halkbank Mavisi Çerçeveli Kart Yapısı -->
<div class="card outlined-card my-4">
    <!-- Çizginin üstünde duran başlık -->
    <span class="outlined-card-title">İcra Takip</span>

    <!-- Kart Üst Barı: Sol Tarafa Dışa Aktar Butonları, Sağ Tarafa Arama & Ekleme -->
    <div class="card-header bg-transparent border-0 pt-4 pb-2 px-4 d-flex justify-content-between align-items-center">

        <!-- Sol Taraf: Excel, PDF ve Yazdır Buton Grubu -->
        <div class="d-flex align-items-center gap-2">
            <span class="text-muted small fw-medium me-1">Dışa Aktar:</span>
            <div class="btn-group btn-group-sm shadow-sm" role="group" aria-label="Dışa Aktar">
                <button type="button" class="btn btn-outline-light text-dark border border-light-subtle bg-white hover-elevate" id="btnExportExcel" title="Excel'e Aktar">
                    <i class="bi bi-file-earmark-excel text-success me-1"></i> Excel
                </button>
                <button type="button" class="btn btn-outline-light text-dark border border-light-subtle bg-white hover-elevate" id="btnExportPdf" title="PDF İndir">
                    <i class="bi bi-file-earmark-pdf text-danger me-1"></i> PDF
                </button>
                <button type="button" class="btn btn-outline-light text-dark border border-light-subtle bg-white hover-elevate" id="btnPrint" title="Yazdır">
                    <i class="bi bi-printer text-primary me-1"></i> Yazdır
                </button>
            </div>
        </div>

        <!-- Sağ Taraf: Animasyonlu Ekleme ve Arama Butonları -->
        <div class="d-flex align-items-center gap-2">
            <!-- 1. Animasyonlu Expandable Arama Çubuğu -->
            <div class="expandable-search" id="searchWrapper">
                <button type="button" class="search-btn" id="searchTriggerBtn">
                    <i class="bi bi-search"></i>
                </button>
                <input type="text" id="globalSearchInput" class="search-input" placeholder="İcra ara..." autocomplete="off" />
            </div>

            <!-- 2. Animasyonlu Expandable İcra Ekle Butonu -->
            <button type="button" class="btn btn-success expandable-btn d-flex align-items-center" data-bs-toggle="modal" data-bs-target="#createModal">
                <i class="bi bi-plus-lg fs-5"></i>
                <span class="btn-text">Yeni İcra Ekle</span>
            </button>
        </div>

    </div>

    <!-- Tablo Alanı -->
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0" id="icraTable">
            <thead class="table-light text-secondary small text-capitalize">
                <tr>
                    <th class="ps-4">Müşteri</th>
                    <th>Ürün</th>
                    <th>Borç Tutarı</th>
                    <th>İcra Takip Tarihi</th>
                    <th>Mahkeme</th>
                    <th>İcra Dosya No</th>
                    <th>Avukat</th>
                    <th class="text-end pe-4 no-print">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var icra in Model)
                {
                    <tr>
                        <td class="ps-4">@((icra.MusteriNo + "-" + icra.MusteriAd + " " + icra.MusteriSoyad).Trim())</td>
                        <td>@icra.UrunAd</td>
                        <td class="fw-semibold text-dark">@icra.BorcTutar.ToString("N2") ₺</td>
                        <td>@icra.IcraTakipTar.ToString("dd.MM.yyyy")</td>
                        <td>@icra.MahkemeAd</td>
                        <td>@icra.IcraDosyaNo</td>
                        <td class="ps-4">@((icra.AvukatAd + " " + icra.AvukatSoyad).Trim())</td>
                        <td class="text-end pe-4 no-print">
                            <div class="dropdown">
                                <button class="btn btn-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"></button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                    <li>
                                        <a class="dropdown-item updateBtn py-2" href="javascript:void(0);" data-id="@icra.IcraId">
                                            <i class="bi bi-pencil me-2 text-primary"></i>Güncelle
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li>
                                        <a class="dropdown-item text-danger deleteBtn py-2" href="javascript:void(0);" data-id="@icra.IcraId">
                                            <i class="bi bi-trash me-2"></i>Sil
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Kart Altı: Sayfalama ve Alt Bilgiler -->
    <div class="card-footer bg-transparent border-top py-3 px-4">
        <div class="row align-items-center g-3">
            <div class="col-md-4 d-flex align-items-center gap-2">
                <label for="icraPageSize" class="form-label mb-0 small text-muted">Sayfada</label>
                <select id="icraPageSize" class="form-select form-select-sm border-light bg-light" style="width: auto;">
                    <option value="5">5</option>
                    <option value="10" selected>10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
                <span class="small text-muted">kayıt göster</span>
            </div>

            <div class="col-md-4 text-center text-muted small">
                <span id="icraTableInfo"></span>
            </div>

            <div class="col-md-4 d-flex justify-content-end align-items-center gap-3">
                <div class="text-muted small">
                    Toplam: <strong id="icraTotalRecordCount">@Model.Count()</strong> |
                    Sayfa: <strong id="icraCurrentPageNum">1</strong> / <strong id="icraTotalPagesNum">1</strong>
                </div>
                <nav>
                    <ul class="pagination pagination-sm mb-0" id="icraPaginationNav"></ul>
                </nav>
            </div>
        </div>
    </div>
</div>

@Html.Partial("_IcraModals", new Entity.Dto.IcraDto())

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Excel ve PDF Dışa Aktarım CDN Kütüphaneleri -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>

    <script src="~/Scripts/common.js"></script>
    <script src="~/Scripts/crud.js?v=1.4"></script>
    <script src="~/Scripts/Icra/icraValidation.js?v=1.1"></script>
    <script src="~/Scripts/Icra/tablePagination.js"></script>

    <script>
        // 1. Ürün dropdown'ını doldurur
        function loadUrunOptions(musteriId, prefix, url, isForUpdate, callback) {
            if (typeof isForUpdate === "function") {
                callback = isForUpdate;
                isForUpdate = false;
            }

            var $urunSelect = $("#" + prefix + "UrunSelect");
            var $ihtarSelect = $("#" + prefix + "IhtarUrunSelect");

            $urunSelect.empty();
            $ihtarSelect.empty().append('<option value="">Önce ürün seçiniz</option>').prop("disabled", true);

            if (!musteriId) {
                $urunSelect.append('<option value="">Önce müşteri seçiniz</option>').prop("disabled", true);
                if (callback) callback();
                return;
            }

            $.get(url, { musteriId: musteriId, isForUpdate: !!isForUpdate })
                .done(function (list) {
                    $urunSelect.append('<option value="">Seçiniz</option>');
                    if (list && list.length > 0) {
                        list.forEach(function (item) {
                            var val = item.value || item.Value;
                            var txt = item.text || item.Text;
                            $urunSelect.append('<option value="' + val + '">' + txt + '</option>');
                        });
                    }
                    $urunSelect.prop("disabled", false);
                    if (callback) callback();
                })
                .fail(function () {
                    if (callback) callback();
                });
        }

        // 2. İhtar dropdown'ını doldurur
        function loadIhtarOptions(musteriId, urunId, prefix, url, callback) {
            var $ihtarSelect = $("#" + prefix + "IhtarUrunSelect");
            $ihtarSelect.empty();

            if (!urunId) {
                $ihtarSelect.append('<option value="">Önce ürün seçiniz</option>').prop("disabled", true);
                if (callback) callback();
                return;
            }

            $.get(url, { musteriId: musteriId, urunId: urunId })
                .done(function (list) {
                    $ihtarSelect.append('<option value="">Seçiniz</option>');
                    if (list && list.length > 0) {
                        list.forEach(function (item) {
                            var val = item.value || item.Value;
                            var txt = item.text || item.Text;
                            $ihtarSelect.append('<option value="' + val + '">' + txt + '</option>');
                        });
                    }
                    $ihtarSelect.prop("disabled", false);
                    if (callback) callback();
                })
                .fail(function () {
                    if (callback) callback();
                });
        }

        $(document).ready(function () {

            // Tarih inputları yer tutucusu
            $(document).on("focus", 'input[type="date"]', function () {
                $(this).attr("placeholder", "gg.aa.yyyy");
            });

            // Otomatik ' E.' tamamlama
            $(document).on("blur", "input[name='IcraDosyaNo'], #IcraDosyaNo, #createIcraDosyaNo", function () {
                var val = $(this).val().trim();
                if (/^(19|20)\d{2}\/\d{1,7}$/.test(val)) {
                    $(this).val(val + " E.");
                }
            });

            // İcra tablosu sayfalama ve tekli arama başlatma
            if (typeof initIcraTablePagination === "function") {
                initIcraTablePagination("icraTable", "icraPageSize", "icraPaginationNav", "icraTableInfo", "globalSearchInput");
            } else if (typeof initTablePagination === "function") {
                initTablePagination("icraTable", "icraPageSize", "icraPaginationNav", "icraTableInfo", "globalSearchInput");
            }

            // CREATE MODAL kademeli seçim dinleyicileri
            $(document).on("change", "#createMusteriSelect", function () {
                loadUrunOptions($(this).val(), "create", "/Icra/GetUrunlerByMusteri", false);
            });
            $(document).on("change", "#createUrunSelect", function () {
                var musteriId = $("#createMusteriSelect").val();
                loadIhtarOptions(musteriId, $(this).val(), "create", "/Icra/GetIhtarlarByMusteriVeUrun");
            });

            // UPDATE MODAL kademeli seçim dinleyicileri
            $(document).on("change", "#updateMusteriSelect", function () {
                loadUrunOptions($(this).val(), "update", "/Icra/GetUrunlerByMusteri", true);
            });
            $(document).on("change", "#updateUrunSelect", function () {
                var musteriId = $("#updateMusteriSelect").val();
                loadIhtarOptions(musteriId, $(this).val(), "update", "/Icra/GetIhtarlarByMusteriVeUrun");
            });

            // Create Modal her açıldığında form sıfırlama
            $("#createModal").on("show.bs.modal", function () {
                $("#createMusteriSelect").val("");
                $("#createUrunSelect").empty().append('<option value="">Önce müşteri seçiniz</option>').prop("disabled", true);
                $("#createIhtarUrunSelect").empty().append('<option value="">Önce ürün seçiniz</option>').prop("disabled", true);
            });

            // Global nesneleri birleştir
            var baseValidationOptions = window.crudOptions || window.icraOptions || {};

            var crudConfig = $.extend(true, {}, baseValidationOptions, {
                validationSkipFields: ["MusteriId", "UrunId"],
                onGetSuccess: function (data) {
                    if (!data) return;

                    var mId = data.MusteriId || data.musteriId;
                    var uId = data.UrunId || data.urunId;
                    var iuId = data.IhtarUrunId || data.ihtarUrunId;

                    $("#updateMusteriSelect, #updateUrunSelect, #updateIhtarUrunSelect").prop("disabled", false);

                    var targetMusteriId = (mId || "").toString().toLowerCase();
                    $("#updateMusteriSelect option").each(function () {
                        if ($(this).val().toLowerCase() === targetMusteriId) {
                            $("#updateMusteriSelect").val($(this).val());
                            return false;
                        }
                    });

                    loadUrunOptions(mId, "update", "/Icra/GetUrunlerByMusteri", true, function () {
                        var targetUrunId = (uId || "").toString().toLowerCase();
                        var selectedUrunValue = "";

                        $("#updateUrunSelect option").each(function () {
                            if ($(this).val().toLowerCase() === targetUrunId) {
                                selectedUrunValue = $(this).val();
                                $("#updateUrunSelect").val(selectedUrunValue);
                                return false;
                            }
                        });

                        var actualUrunId = selectedUrunValue || uId;
                        loadIhtarOptions(mId, actualUrunId, "update", "/Icra/GetIhtarlarByMusteriVeUrun", function () {
                            var targetIhtarUrunId = (iuId || "").toString().toLowerCase();

                            $("#updateIhtarUrunSelect option").each(function () {
                                if ($(this).val().toLowerCase() === targetIhtarUrunId) {
                                    $("#updateIhtarUrunSelect").val($(this).val());
                                    return false;
                                }
                            });

                            $("#updateIhtarUrunIdHidden").val(iuId);

                            // Dolum bitince kilitleriz
                            $("#updateMusteriSelect, #updateUrunSelect, #updateIhtarUrunSelect").prop("disabled", true);
                        });
                    });
                }
            });

            // initCrud Çağrısı
            initCrud("Icra", ["IcraId", "MahkemeId", "IcraDosyaNo", "IcraTakipTar"], crudConfig);

            // Arama İkonu Tıklama Mantığı
            $("#searchTriggerBtn").on("click", function (e) {
                e.stopPropagation();
                $("#searchWrapper").toggleClass("expanded");
                if ($("#searchWrapper").hasClass("expanded")) {
                    $("#globalSearchInput").focus();
                }
            });

            $("#globalSearchInput").on("click", function (e) {
                e.stopPropagation();
            });

            $(document).on("click", function () {
                if ($("#globalSearchInput").val().trim() === "") {
                    $("#searchWrapper").removeClass("expanded");
                }
            });

            // --------------------------------------------------------------------------
            // DIŞA AKTAR BUTONLARI (EXCEL, PDF, YAZDIR)
            // --------------------------------------------------------------------------

            // 1. EXCEL
            $("#btnExportExcel").on("click", function () {
                var data = [];
                var headers = ["Musteri", "Urun", "Borc Tutari", "Icra Takip Tarihi", "Mahkeme", "Icra Dosya No", "Avukat"];
                data.push(headers);

                $("#icraTable tbody tr:visible").each(function () {
                    var $tds = $(this).find("td");
                    if ($tds.length > 1) {
                        data.push([
                            $tds.eq(0).text().trim(),
                            $tds.eq(1).text().trim(),
                            $tds.eq(2).text().trim(),
                            $tds.eq(3).text().trim(),
                            $tds.eq(4).text().trim(),
                            $tds.eq(5).text().trim(),
                            $tds.eq(6).text().trim()
                        ]);
                    }
                });

                var wb = XLSX.utils.book_new();
                var ws = XLSX.utils.aoa_to_sheet(data);
                XLSX.utils.book_append_sheet(wb, ws, "IcraTakip");
                XLSX.writeFile(wb, "Icra_Takip_Listesi.xlsx");
            });

            // 2. YAZDIR
            $("#btnPrint").on("click", function () {
                window.print();
            });

            // 3. PDF (Landscape A4 Formatında)
            $("#btnExportPdf").on("click", function () {
                try {
                    var { jsPDF } = window.jspdf;
                    var doc = new jsPDF('l', 'mm', 'a4');

                    var headers = [["Musteri", "Urun", "Borc Tutari", "Icra Takip Tarihi", "Mahkeme", "Icra Dosya No", "Avukat"]];
                    var body = [];

                    $("#icraTable tbody tr:visible").each(function () {
                        var $tds = $(this).find("td");
                        if ($tds.length > 1) {
                            body.push([
                                $tds.eq(0).text().trim(),
                                $tds.eq(1).text().trim(),
                                $tds.eq(2).text().trim(),
                                $tds.eq(3).text().trim(),
                                $tds.eq(4).text().trim(),
                                $tds.eq(5).text().trim(),
                                $tds.eq(6).text().trim()
                            ]);
                        }
                    });

                    doc.autoTable({
                        head: headers,
                        body: body,
                        startY: 15,
                        theme: 'grid',
                        headStyles: { fillColor: [1, 83, 139] },
                        styles: { fontSize: 9, cellPadding: 3 }
                    });

                    doc.save("Icra_Takip_Listesi.pdf");
                } catch (err) {
                    console.error("PDF Oluşturma Hatası:", err);
                    showErrorModal("PDF dosyası indirilirken bir sorun oluştu.");
                }
            });
        });
    </script>
}