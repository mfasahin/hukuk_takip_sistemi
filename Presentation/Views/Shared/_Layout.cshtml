<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>

    <!-- 1. Önce Bootstrap CSS -->
    <link href="~/Content/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <!-- 2. Sonra Özel CSS (Bootstrap'i ezesin diye en alta koyuyoruz) -->
    <link href="~/Content/Site.css?v=1.2" rel="stylesheet" />

    <!-- jQuery ve Bootstrap JS (Head içinde veya body sonunda olabilir) -->
    <script src="~/Content/jquery/jquery-4.0.0.min.js"></script>
    <script src="~/Content/bootstrap/js/bootstrap.bundle.min.js"></script>
</head>
<body>

    <!-- Sidebar + Content -->
    <div class="container-fluid p-0">
        <div class="row g-0">
            <!-- Sidebar -->
            <div class="col-md-2">
                @Html.Partial("_Sidebar")
            </div>

            <!-- Main Content -->
            <div class="col-md-10 p-3 body-content">
                @RenderBody()
                <hr />
            </div>
        </div>
    </div>

    <!-- Modallar -->
    @Html.Partial("ErrorModal")

    <div class="modal fade" id="successModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-center p-4">
                <div class="mb-2">
                    <span style="font-size:3rem; color:#198754;">&#10003;</span>
                </div>
                <h5 id="successModalMessage">İşlem başarılı!</h5>
                <button type="button" class="btn btn-success mt-3" data-bs-dismiss="modal">Tamam</button>
            </div>
        </div>
    </div>

    <div class="modal fade" id="confirmModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-center p-4">
                <div class="mb-2">
                    <span style="font-size:3rem; color:#dc3545;">&#9888;</span>
                </div>
                <h5 id="confirmModalMessage">Bu kaydı silmek istediğinize emin misiniz?</h5>
                <div class="mt-3 d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="button" class="btn btn-danger" id="confirmModalOkBtn">Evet, Sil</button>
                </div>
            </div>
        </div>
    </div>

    <!-- JS Bağımlılıkları -->
    <script src="~/Scripts/checkbox.js"></script>
    <script src="~/Scripts/common.js"></script>

    @RenderSection("scripts", required: false)
</body>
</html>