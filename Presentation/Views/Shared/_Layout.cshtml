<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>

    <!-- 1. Önce Bootstrap CSS -->
    <link href="~/Content/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <!-- 2. Sonra Özel CSS (Bootstrap'i ezesin diye en alta koyuyoruz) -->
    <link href="~/Content/Site.css?v=1.2" rel="stylesheet" />

    <!-- jQuery ve Bootstrap JS (Head içinde veya body sonunda olabilir) -->
    <script src="~/Content/jquery/jquery-4.0.0.min.js"></script>
    <script src="~/Content/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- Select2 CSS & Bootstrap 5 Teması -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

    <!-- Select2 JS (jQuery'den sonra yüklenmelidir) -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <!-- SweetAlert2 CSS & JS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="~/Scripts/common.js"></script>

    <script src="~/Scripts/crud.js"></script>
</head>
<body>

    <!-- Sidebar + Content -->
    <div class="container-fluid p-0">
        <div class="row g-0">
            <!-- Sidebar -->
            <div class="col-md-2">
                @Html.Partial("_Sidebar")
            </div>

            <!-- Main Content -->
            <div class="col-md-10 p-3 body-content">
                @RenderBody()
                <hr />
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            $(document).on("click", "#btnLogout", function (e) {
                e.preventDefault();

                showConfirmModal("Oturumunuz kapatılacaktır. Emin misiniz?", function () {
                    $.ajax({
                        url: '/Kullanici/Logout',
                        type: 'GET',
                        success: function (result) {
                            if (result && result.redirectUrl) {
                                window.location.href = result.redirectUrl;
                            } else {
                                window.location.href = '/Kullanici/Login';
                            }
                        },
                        error: function () {
                            window.location.href = '/Kullanici/Login';
                        }
                    });
                });
            });
        });
    </script>



    @RenderSection("scripts", required: false)
</body>
</html>