            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Icra" ? "active" : "")" href="@Url.Action("Index","Icra")">
                <i class="bi bi-file-text"></i> <span>İcra Takip</span>
            </a>
        </li>
