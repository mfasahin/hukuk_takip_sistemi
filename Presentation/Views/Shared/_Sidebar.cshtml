<div class="sidebar vh-100">
    <!-- Logo -->
    <div class="sidebar-logo mb-4">
        <img src="~/Content/images/halkbank_logo_2.jpg" alt="Logo" class="w-100" />
    </div>

    <!-- Menü Linkleri -->
    <ul class="nav flex-column">
        <li class="nav-item">
            <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Musteri" ? "active" : "")" href="@Url.Action("Index","Musteri")">
                <i class="bi bi-people"></i> <span>Müşteriler</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "Urun" ? "active" : "")" href="@Url.Action("Index","Urun")">
