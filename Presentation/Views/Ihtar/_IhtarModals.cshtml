@model Entity.Dto.IhtarDto

<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1" aria-labelledby="createModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            @using (Html.BeginForm("Create", "Ihtar", FormMethod.Post, new { id = "createForm" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header text-white" style="background-color: #01538b;">
                    <h5 class="modal-title" id="createModalLabel">Yeni İhtar</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>

                <div class="modal-body">
                    <div class="container-fluid">
                        <div class="row mb-3">
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.MusteriId, "Müşteri", new { @class = "form-label fw-bold" })
                                @Html.DropDownListFor(m => m.MusteriId,
                                    ViewBag.MusteriList as IEnumerable<SelectListItem>,
                                    "Müşteri Seç",
                                    new { @class = "form-select", id = "MusteriId" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.UrunId, "Ürün", new { @class = "form-label fw-bold" })
                                @Html.DropDownListFor(m => m.UrunId,
                                    ViewBag.UrunList as IEnumerable<SelectListItem>,
                                    "Ürün Seç",
                                    new { @class = "form-select", id = "UrunId" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.BorcTutar, "Borç Tutarı", new { @class = "form-label fw-bold" })
                                @Html.TextBoxFor(m => m.BorcTutar,
                                    new { @class = "form-control", id = "BorcTutar", type = "number", step = "0.01", placeholder = "0.00" })
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.IhtarTarih, "İhtar Tarihi", new { @class = "form-label fw-bold" })
                                @Html.TextBoxFor(m => m.IhtarTarih,
                                    new { @class = "form-control", id = "IhtarTarih", type = "date" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.SubeId, "Şube", new { @class = "form-label fw-bold" })
                                @Html.DropDownListFor(m => m.SubeId,
                                    ViewBag.SubeList as IEnumerable<SelectListItem>,
                                    "Şube Seç",
                                    new { @class = "form-select", id = "SubeId" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.AvukatId, "Avukat", new { @class = "form-label fw-bold" })
                                @Html.DropDownListFor(m => m.AvukatId,
                                    ViewBag.AvukatList as IEnumerable<SelectListItem>,
                                    "Avukat Seç",
                                    new { @class = "form-select", id = "AvukatId" })
                            </div>
                        </div>

                        <!-- Sadece Tüm Form Boş Olduğunda Görünecek Hata Alanı -->
                        <div id="formGeneralError" class="row d-none">
                            <div class="col-12">
                                <div class="alert alert-danger mb-0 text-center py-2 error-message-container"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="button" id="createSaveBtn" class="btn btn-success px-4">Kaydet</button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Update Modal -->
<div class="modal fade" id="updateModal" tabindex="-1" aria-labelledby="updateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            @using (Html.BeginForm("Update", "Ihtar", FormMethod.Post, new { id = "updateForm" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.IhtarId, new { id = "IhtarId" })

                <div class="modal-header text-white" style="background-color: #01538b;">
                    <h5 class="modal-title" id="updateModalLabel">İhtar Güncelle</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>

                <div class="modal-body">
                    <div class="container-fluid">
                        <div class="row mb-3">
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.MusteriId, "Müşteri", new { @class = "form-label fw-bold" })
                                @Html.DropDownListFor(m => m.MusteriId,
                                    ViewBag.MusteriList as IEnumerable<SelectListItem>,
                                    "Müşteri Seç",
                                    new { @class = "form-select", id = "UpdateMusteriId" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.UrunId, "Ürün", new { @class = "form-label fw-bold" })
                                @Html.DropDownListFor(m => m.UrunId,
                                    ViewBag.UrunList as IEnumerable<SelectListItem>,
                                    "Ürün Seç",
                                    new { @class = "form-select", id = "UpdateUrunId" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.BorcTutar, "Borç Tutarı", new { @class = "form-label fw-bold" })
                                @Html.TextBoxFor(m => m.BorcTutar,
                                    new { @class = "form-control", id = "UpdateBorcTutar", type = "number", step = "0.01" })
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.IhtarTarih, "İhtar Tarihi", new { @class = "form-label fw-bold" })
                                @Html.TextBoxFor(m => m.IhtarTarih,
                                    new { @class = "form-control", id = "UpdateIhtarTarih", type = "date" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.SubeId, "Şube", new { @class = "form-label fw-bold" })
                                @Html.DropDownListFor(m => m.SubeId,
                                    ViewBag.SubeList as IEnumerable<SelectListItem>,
                                    "Şube Seç",
                                    new { @class = "form-select", id = "UpdateSubeId" })
                            </div>
                            <div class="col-md-4">
                                @Html.LabelFor(m => m.AvukatId, "Avukat", new { @class = "form-label fw-bold" })
                                @Html.DropDownListFor(m => m.AvukatId,
                                    ViewBag.AvukatList as IEnumerable<SelectListItem>,
                                    "Avukat Seç",
                                    new { @class = "form-select", id = "UpdateAvukatId" })
                            </div>
                        </div>

                        <div id="updateFormGeneralError" class="row d-none">
                            <div class="col-12">
                                <div class="alert alert-danger mb-0 text-center py-2 error-message-container"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="button" id="updateSaveBtn" class="btn btn-success px-4">Kaydet</button>
                </div>
            }
        </div>
    </div>
</div>