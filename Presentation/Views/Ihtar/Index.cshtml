@model IEnumerable<Entity.Dto.IhtarDto>

@{
    ViewBag.Title = "İhtar Listesi";
}

<h2>İhtar Takip</h2>

<div style="display:flex; justify-content:flex-end; gap:10px; margin-bottom:10px;">
    <button type="button" class="btn btn-success"
            data-bs-toggle="modal"
            data-bs-target="#createModal">
        İhtar Ekle
    </button>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th><input type="checkbox" id="selectAll" /></th>
            <th>Müşteri</th>
            <th>Borç Tutarı</th>
            <th>İhtar Tarihi</th>
            <th>Şube</th>
            <th>Avukat</th>
            <th>Ürün</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ihtar in Model)
        {
            <tr>
                <td><input type="checkbox" class="rowCheckbox" value="@ihtar.IhtarId" /></td>
                <td>@ihtar.MusteriAd  @ihtar.MusteriSoyad</td>
                <td>@ihtar.BorcTutar</td>
                <td>@ihtar.IhtarTarih.ToString("dd.MM.yyyy")</td>
                <td>@ihtar.SubeAd</td>
                <td>@ihtar.AvukatAd @ihtar.AvukatSoyad</td>
                <td> @ihtar.UrunAd </td>

                <td>
                    <div class="dropdown">
                        <button class="btn btn-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        </button>
                        <ul class="dropdown-menu">
                            <li>
                                <a class="dropdown-item text-danger updateBtn" data-id="@ihtar.IhtarId">Güncelle</a>
                            </li>
                            <li>
                                <a class="dropdown-item text-danger deleteBtn" data-id="@ihtar.IhtarId">Sil</a>
                            </li>
                        </ul>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@Html.Partial("_IhtarModals", new Entity.Dto.IhtarDto())

@section Scripts {
    <script src="~/Scripts/crud.js"></script>
    <script>
        initCrud("Ihtar", ["IhtarId", "MusteriId", "SubeId", "AvukatId", "BorcTutar", "IhtarTarih", "UrunId"], {
            validationRules: {
                "MusteriId": function (value) {
                    if (!value || value === "0") return "Müşteri seçilmelidir.";
                    return null;
                },
                "UrunId": function (value) {
                    if (!value || value === "0") return "Ürün seçilmelidir.";
                    return null;
                },
                "SubeId": function (value) {
                    if (!value || value === "0") return "Şube seçilmelidir.";
                    return null;
                },
                "AvukatId": function (value) {
                    if (!value || value === "0") return "Avukat seçilmelidir.";
                    return null;
                },
                "BorcTutar": function (value) {
                    if (!value || value.trim() === "") return "Borç tutarı zorunludur.";
                    if (isNaN(value)) return "Borç tutarı sadece rakamlardan oluşmalıdır.";
                    if (parseFloat(value) <= 0) return "Borç tutarı 0'dan büyük olmalıdır.";
                    return null;
                },
                "IhtarTarih": function (value) {
                    if (!value || value.trim() === "") return "İhtar tarihi zorunludur.";
                    var date = new Date(value);
                    if (isNaN(date.getTime())) return "Geçerli bir tarih giriniz.";
                    // if (date > new Date()) return "İhtar tarihi gelecekte olamaz.";
                    return null;
                }
            }
        });

    </script>
}
