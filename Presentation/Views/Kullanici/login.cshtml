@model Presentation.Models.KullaniciModel
@{
    ViewBag.Title = "Giriş Yap";
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Giriş Yap - Hukuk Takip Sistemi</title>

    <!-- Google Fonts: Montserrat -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&display=swap" rel="stylesheet">

    <link href="~/Content/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/Content/login.css?v=1.3" />

    <script src="~/Content/jquery/jquery-4.0.0.min.js"></script>
    <script src="~/Content/bootstrap/js/bootstrap.bundle.min.js"></script>
</head>
<body>

    <!-- Üst İnce Beyaz Şerit -->
    <header class="login-header-1"></header>

    <!-- Ana Header Şeridi -->
    <header class="login-header">
        <div class="container text-center">
            <h1 class="header-title">HUKUK TAKİP SİSTEMİ</h1>
        </div>
    </header>

    <!-- Giriş Formu Alanı -->
    <main class="login-container">
        <div class="login-card">

            <!-- KART İÇİ KARŞILAMA BAŞLIĞI (Dikey Uzatma Sağlar) -->
            <div class="welcome-header text-center mb-4">
                <h2 class="welcome-title">Hoş Geldiniz</h2>
                <p class="welcome-subtitle">Devam etmek için lütfen giriş yapın</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger text-center mb-4">@ViewBag.Error</div>
            }

            @using (Html.BeginForm("Login", "Kullanici", FormMethod.Post, new { @class = "login-form" }))
            {
                @Html.AntiForgeryToken()

                <div class="mb-4">
                    @Html.LabelFor(m => m.KullaniciAd, "KULLANICI ADI", new { @class = "form-label custom-label" })
                    @Html.TextBoxFor(m => m.KullaniciAd, new { @class = "form-control custom-input", placeholder = "Kullanıcı adınızı girin" })
                    @Html.ValidationMessageFor(m => m.KullaniciAd, "", new { @class = "text-danger" })
                </div>

                <div class="mb-4">
                    @Html.LabelFor(m => m.Sifre, "ŞİFRE", new { @class = "form-label custom-label" })
                    @Html.PasswordFor(m => m.Sifre, new { @class = "form-control custom-input", placeholder = "Şifrenizi girin" })
                    @Html.ValidationMessageFor(m => m.Sifre, "", new { @class = "text-danger" })
                </div>

                <button type="submit" class="btn btn-login w-100">
                    <img src="~/Content/images/HALKBANK.png" class="login-btn-img" alt="Halkbank" />
                    <span>GİRİŞ</span>
                </button>
            }

            <div class="text-center mt-4 pt-2">
                <a href="@Url.Action("Register", "Kullanici")" class="register-link">Kayıt ol</a>
            </div>

        </div>
    </main>
</body>
</html>